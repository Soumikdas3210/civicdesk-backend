NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=civicdesk

JWT_SECRET=
JWT_EXPIRES_IN=7d

# INV-4 fallback. Used when no SLAPolicy matches (categoryId, priority).
GLOBAL_DEFAULT_RESPONSE_HOURS=24
GLOBAL_DEFAULT_RESOLUTION_HOURS=72

# Grace window before the scheduled job closes a RESOLVED grievance (PRD Section 4).
AUTO_CLOSE_AFTER_DAYS=7

# Deferred to Phase 2. Present now so .env is never restructured.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@civicdesk.local

AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash